BRAINTREE_TEST_MERCHANT_ID=change_me
BRAINTREE_TEST_PUBLIC_KEY=change_me
BRAINTREE_TEST_SECRET_KEY=change_me

# Munim API keys are per-organization now — connect via the Settings > Integrations UI.
MUNIM_BASE_URL=change_me

KAFKA_URL=redpanda:29092
# Namespace these per environment whenever more than one Lotus stack shares a
# broker, otherwise both stacks produce to and consume from the same topics in
# the same group — partitions get split across environments and events land in
# the wrong database.
#   EVENTS_TOPIC          read by Django AND both Go services
#   INVOICE/PAYMENT_TOPIC Django only (produce-only; nothing consumes them)
#   KAFKA_CONSUMER_GROUP  event-guidance only
# KAFKA_PREFIX exists but only reaches Django, so it cannot isolate the Go
# services — set the topic names explicitly instead.
EVENTS_TOPIC=prod-events
INVOICE_TOPIC=prod-invoices
PAYMENT_TOPIC=prod-payments
KAFKA_CONSUMER_GROUP=lotus-prod

SVIX_JWT_SECRET=change_me


AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me

TAXJAR_API_KEY=change_me